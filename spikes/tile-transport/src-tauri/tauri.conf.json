{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-tile-transport",
  "version": "0.0.0",
  "identifier": "dev.quire.spike.tiletransport",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' blob: data:",
        "connect-src": "ipc: http://ipc.localhost http://tile.localhost"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../apps/desktop/src-tauri/icons/icon.png",
      "../../../apps/desktop/src-tauri/icons/icon.ico"
    ]
  }
}
