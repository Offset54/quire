{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal permissions for the main window (§8: minimal Tauri capability permissions).",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-trace-status",
    "allow-trace-ingest",
    "allow-view-request-tiles",
    "allow-view-relayout",
    "allow-view-close",
    "allow-perf-stats"
  ]
}
