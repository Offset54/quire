{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal permissions for the main window (§8: minimal Tauri capability permissions).",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-trace-status",
    "allow-trace-ingest",
    "allow-view-request-tiles",
    "allow-view-relayout",
    "allow-view-close",
    "allow-perf-stats",
    "allow-txt-startup",
    "allow-txt-open",
    "allow-txt-new",
    "allow-txt-close",
    "allow-txt-view",
    "allow-txt-edit",
    "allow-txt-paste",
    "allow-txt-copy",
    "allow-txt-seek",
    "allow-txt-goto-line",
    "allow-txt-search",
    "allow-txt-search-cancel",
    "allow-txt-find",
    "allow-txt-replace-all",
    "allow-txt-cancel",
    "allow-txt-save",
    "allow-txt-set-format",
    "allow-txt-reopen",
    "allow-txt-allow-edit",
    "allow-txt-status",
    "allow-txt-check-disk",
    "allow-txt-disk-resolve",
    "allow-txt-recovery-list",
    "allow-txt-recover",
    "allow-txt-recovery-discard",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
