# Source text is LF in the repo and in every working tree, on every OS.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Test inputs are byte-exact: encodings, BOMs and line endings are what the tests check.
# Never let git normalize them.
**/testdata/** -text -diff
**/tests/data/** -text -diff
fuzz/regressions/** -text -diff
fuzz/seeds/** -text -diff

