root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Test inputs are byte-exact; editors must not touch them.
[{**/testdata/**,**/tests/data/**,fuzz/regressions/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
